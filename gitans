## Step 6: FINAL PIPELINE SCRIPT (FIXED)

```groovy
pipeline {
    agent any

    stages {

        stage('Clone') {
            steps {
                git 'https://github.com/YOUR-USERNAME/university-dept-website.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t university-app .'
            }
        }

        stage('Run Container') {
            steps {
                bat 'docker rm -f university-container || true'
                bat 'docker run -d -p 8081:80 --name university-container university-app'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat 'kubectl apply -f deployment.yaml'
                bat 'kubectl apply -f service.yaml'
            }
        }
    }
}
```

